# คัดลอกเป็นไฟล์ .env (ในโฟลเดอร์ BE) แล้วแก้ค่า — ห้าม commit .env และห้ามวาง key จริงลงแชต/ไฟล์นี้

# ---- Server ----
PORT=3000
# โดเมนของ Frontend ที่อนุญาตให้เรียก API (คั่นด้วย ,) ใส่ * = อนุญาตทุกที่
# (ถ้า FE เรียกผ่าน nginx/vite proxy แบบ Week 11 ไม่ต้องตั้งก็ได้)
CORS_ORIGIN=*

# ---- PostgreSQL ----
# ตอนรันด้วย npm run dev (Postgres รันใน Docker ที่พอร์ต 5432: docker-compose up -d db)
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
# ตั้งเป็น true ถ้าใช้ External Database URL ของ Render / Neon / Supabase (Internal URL ของ Render ไม่ต้อง)
DATABASE_SSL=false
# สร้างตารางอัตโนมัติตอนเปิด server
AUTO_MIGRATE=true
# โหลด seed/portfolio.json ตอนเปิด server: always | if-empty | off
SEED_MODE=always

# ---- AI (OpenAI-compatible API) ----
# สร้าง key ที่ https://aistudio.google.com/apikey  (ไม่ใส่ = ใช้โหมดออฟไลน์ ตอบจากข้อมูลแบบง่าย ๆ)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# BE อยู่หลัง proxy (Render + nginx ของ FE): true = ใช้ IP จริงของผู้ใช้จาก X-Forwarded-For ในการจำกัดความถี่
TRUST_PROXY=true

# ---- AI timeout (ms) ต้องน้อยกว่า 30 วินาทีที่ FE รอ ----
LLM_TIMEOUT_MS=20000

# ---- Chat ----
CHAT_MAX_HISTORY=10
CHAT_MAX_LENGTH=1000
CHAT_RATE_LIMIT=20

# ---- Admin (ไม่ตั้ง = ปิด endpoint แก้ portfolio / ดูประวัติแชตทั้งหมด) ----
ADMIN_TOKEN=
